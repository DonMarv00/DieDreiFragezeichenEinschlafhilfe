<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.Dark">
        <!-- Customize your theme here. -->

        <item name="colorPrimary">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorAccent</item>


        <item name="android:colorBackground">@color/black</item>
        <item name="colorOnBackground">@color/black</item>
        <item name="colorSurface">@color/colorPrimary</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceInverse">@color/colorAccent</item>


    </style>

    <style name="ToolbarColoredBackArrow" parent="AppTheme">
        <item name="android:textColorSecondary">@color/white</item>
    </style>

    <style name="AppThemeNoToolbar" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorAccent</item>


        <item name="android:colorBackground">@color/black</item>
        <item name="colorOnBackground">@color/black</item>
        <item name="colorSurface">@color/colorPrimary</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceInverse">@color/colorAccent</item>
    </style>

    <style name="MyAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/MyDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/MyDialogButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/MyDialogButtonStyle</item>
    </style>

    <style name="MyDialogButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@android:color/white</item>
    </style>

</resources>